GOOGLE_API_KEY=your-google-api-key
GEMINI_CAPTION_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_API_VERSION=v1beta

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-api-token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

CODEX_BIN=codex
CODEX_IMAGE_MODEL=gpt-5.4-mini
CODEX_IMAGE_TIMEOUT=900
CODEX_IMAGE_SIZE=1024x1024
CODEX_IMAGE_FORMAT=jpeg
CODEX_IMAGE_OUTPUT=result.jpg

# scripts/run_sweep.py — write token for the attributions repo, read token for the
# (private) dataset repo. A single token with write access to both works.
HF_TOKEN=hf_xxx
HF_ATTRIBUTIONS_REPO=Matgc04/neuralatlas-attributions
HF_DATASET_REPO=Matgc04/neuralatlas-imagenet-pico

# Only needed if run_sweep.py has to fall back to rebuilding the dataset from Kaggle.
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
